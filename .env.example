# ===========================================================================
# .env.example - the complete environment contract of this service
# ===========================================================================
#
# This file is a TRACKED, COMMITTED template. Treat every value in it as
# public: it contains no secret, no real origin, no real hostname and no real
# certificate path, and none may ever be added. Real deployment values belong
# in an untracked `.env` (or in the deployment platform's own configuration
# store); `.gitignore` excludes `.env` and `.env.*`, and carries a
# `!.env.example` negation so this template alone stays tracked.
#
# HOW THESE VARIABLES REACH THE SERVICE
# -------------------------------------
# The application does NOT load this file. There is no `dotenv` dependency and
# none may be added - the authorised dependency set is exactly `express`,
# `helmet`, `express-rate-limit`, `cors`, `zod` and the `supertest`
# devDependency. Every value below is read straight from the process
# environment by `config/security.js`, so supply them the way your platform
# supplies environment variables:
#
#   VAR=value node server.js                      # one-off, per invocation
#   set -a; . ./.env; set +a; node server.js       # from a local untracked .env
#   (or the environment/secret manager of your deployment platform)
#
# AUTHORITY AND VALIDATION
# ------------------------
# `config/security.js` is the single source of truth. The names and defaults
# below reproduce it character for character; where this file and that module
# ever disagree, THAT MODULE WINS and this file is the defect. It resolves
# every value once, at require time, and it FAILS CLOSED:
#
#   * unset, empty or whitespace-only is treated as ABSENT, and the documented
#     default applies - and every default below is the restrictive outcome, so
#     falling back can never fail open;
#   * a value that is present but unparseable is never guessed. Startup is
#     refused with an explanatory error instead, so a misconfigured deployment
#     stops rather than running with a silently weakened policy.
#
# Two security settings are deliberately NOT variables and cannot be changed
# here or anywhere else at runtime: the TLS protocol floor is hard-coded to
# `TLSv1.2`, and `Strict-Transport-Security` always carries
# `includeSubDomains`. Do not look for variables for them - weakening either by
# configuration is exactly what the hard-coding prevents.
#
# The eleven variables below are the whole contract - no more, no fewer. There
# is no `NODE_ENV`, no log level, no database URL and no authentication or
# session secret, because this service has no such surface.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# Bind address. Default: 127.0.0.1 - the literal the pre-remediation listener
# hard-coded, preserved exactly so behaviour is unchanged.
#
# SECURITY NOTE: loopback binding is a MITIGATING FACTOR, NOT A CONTROL. It is
# one value away from being a public bind, it confers nothing on a shared or
# containerised host, and it does nothing at all about supply-chain exposure.
# No control in this service depends on it, and none may be relaxed on the
# assumption that the bind address is loopback. Set this to 0.0.0.0 only when
# you intend the service to be reachable off-host.
HOST=127.0.0.1

# Listen port. Default: 3000 - the pre-remediation literal, preserved.
# Accepted range 0-65535, where 0 asks the operating system for an ephemeral
# port. Must be a whole base-10 integer with no unit or suffix; anything else
# refuses startup rather than being truncated to a value nobody wrote.
PORT=3000

# ---------------------------------------------------------------------------
# Cross-origin resource sharing (CORS)
# ---------------------------------------------------------------------------

# Comma-separated allow-list of EXACT origins permitted to read responses from
# a browser. Default: EMPTY, which DENIES EVERY CROSS-ORIGIN CALLER.
#
# The empty default is the deliberate fail-closed choice, not an oversight: an
# unconfigured deployment refuses cross-origin access instead of leaking it.
# Enumerate each legitimate origin in full, scheme included, for example
#
#   ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#
# (that is an illustrative placeholder - substitute your own origins).
#
# NEVER USE A WILDCARD. `ALLOWED_ORIGINS=*` would admit every origin on the
# internet, satisfying "configure CORS" in name while leaving the vulnerability
# entirely unremediated; a wildcard pattern such as `https://*.example.com`
# would additionally never match anything, because origins are compared by
# exact string with no globbing and no regular expressions. Either one refuses
# startup with an explanatory error rather than being silently accepted or
# stripped. Entries are lowercased, one trailing slash is stripped (browsers
# send `Origin` without one) and duplicates collapse.
#
# HOW TO VERIFY THE POLICY - and how NOT to. A response whose content depends
# on the caller's `Origin` carries `Vary: Origin`, so an intermediary cache can
# never serve one origin's response to another; the pre-remediation listener
# emitted no `Vary` at all, which is the gap that closes.
#
# A denied origin is NEVER answered with `403`. The request itself still
# succeeds - a preflight with a success status such as `204`, a simple request
# with `200` - and what is withheld is the `Access-Control-Allow-Origin`
# header, which is precisely what stops the browser handing the response to the
# calling page. THE CONTROL IS THE ABSENCE OF THAT HEADER, NEVER THE STATUS
# CODE. A reviewer who expects a rejection status for a denied origin will
# wrongly conclude the allow-list is broken, and must check the headers
# instead:
#
#   curl -sS -D - -o /dev/null -H 'Origin: https://rogue.invalid' \
#     http://127.0.0.1:3000/          # expect NO Access-Control-Allow-Origin
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# HTTP method allow-list
# ---------------------------------------------------------------------------

# Comma-separated HTTP methods this service will serve. Default: GET, HEAD -
# least privilege, being the only two verbs it actually implements. Every other
# verb is answered `405 Method Not Allowed` with an `Allow` header listing
# exactly this set.
#
# This is the setting that closes Cross-Site Tracing: `TRACE` and `TRACK` are
# simply not members of the default set, and they cannot be made members -
# together with `CONNECT`, which would invite proxy abuse, they are refused
# outright, because rejecting them IS the control rather than a default that
# happens to be convenient. Entries are uppercased and de-duplicated, and each
# must look like an HTTP method token (letters, digits and hyphens), so nothing
# header-shaped can ever reach the `Allow` header. Widen this only to verbs the
# service genuinely implements.
#
# Whitespace around each entry is ignored, so `GET,HEAD` and `GET, HEAD` are
# equivalent and both resolve to the documented `GET, HEAD` default. The value
# is written without a space here so that this template stays safe to source
# through a shell as well as to hand to an env-file loader verbatim; quote any
# value you add that does contain a space.
ALLOWED_METHODS=GET,HEAD

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Length of the rate-limit accounting window, in MILLISECONDS.
# Default: 900000 - fifteen minutes. Must be a whole integer of at least 1; a
# window of 0 would leave the limiter with nothing to account against.
RATE_LIMIT_WINDOW_MS=900000

# Requests a single client may make per window before being throttled.
# Default: 100. Once the budget is exhausted the client receives `429 Too Many
# Requests` with `Retry-After` and standards-track `RateLimit` headers.
#
# This is a deliberately conservative platform-chosen default matching the rate
# limiter's own documented example, not a measured figure - no traffic data for
# this service exists. Tune it here when real traffic says otherwise; no code
# change is needed. Must be a whole integer of at least 1: a budget of 0
# disables the limiter outright, which is a fail-open trap rather than a valid
# setting, so it is refused.
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Request body ceiling
# ---------------------------------------------------------------------------

# Hard upper bound on the size of any request body, applied uniformly to every
# body parser. Default: 1kb. Oversized payloads are rejected with `413 Payload
# Too Large` before the body is parsed, so the memory is never consumed.
#
# Accepts a byte size with an optional unit - `b`, `kb`, `mb`, `gb`, `tb`, `pb`
# - such as `512b`, `1kb` or `10kb`, or a plain byte count such as `1024`. 1kb
# is a genuine tightening: the service consumes no request body at all, while
# the pre-remediation listener accepted a 100,000-byte body with no bound
# whatsoever. Keep it as small as the service's real needs allow.
#
# A typo here is refused rather than passed through (`1kbb` refuses startup),
# because a body parser treats a size it cannot parse as NO LIMIT AT ALL - a
# silent restoration of the unbounded body this setting exists to prevent.
JSON_BODY_LIMIT=1kb

# ---------------------------------------------------------------------------
# TLS / HTTPS transport
# ---------------------------------------------------------------------------

# Whether to serve HTTPS instead of cleartext HTTP. Default: false.
#
# HTTPS is OPT-IN so that `node server.js` still starts with no configuration
# and no certificate material anywhere on the machine. Turning it on requires
# BOTH path variables below to be set - a missing path refuses startup rather
# than quietly falling back to cleartext for a deployment that explicitly asked
# for encryption. The protocol floor is `TLSv1.2` and is hard-coded, so
# obsolete protocol versions are refused at the handshake and cannot be
# re-admitted through configuration.
#
# Accepted: true, 1, yes, on / false, 0, no, off (case-insensitive). Anything
# else - `ture`, `maybe` - refuses startup instead of being read as "off".
TLS_ENABLED=false

# Filesystem PATH of the TLS private key. Unset by default.
#
# A PATH ONLY. Never paste key material - no PEM block, no base64 blob, no
# passphrase - into this variable, into this file, or into any file inside the
# repository. The key must live OUTSIDE the repository, readable only by the
# service account. `.gitignore` excludes *.pem, *.key, *.crt, *.p12 and *.pfx
# so that a stray copy inside the checkout cannot be committed by accident, but
# keeping the material outside the checkout entirely is the actual requirement.
# Provisioning, storage and rotation of real certificates is an operational
# task outside this repository.
#
# Example shape only - substitute a real path in your untracked .env:
#   TLS_KEY_PATH=/absolute/path/outside/repo/dev.key
TLS_KEY_PATH=

# Filesystem PATH of the TLS certificate (or certificate chain). Unset by
# default. Same constraints as TLS_KEY_PATH above: a path only, outside the
# repository, never inline material.
#
# Example shape only - substitute a real path in your untracked .env:
#   TLS_CERT_PATH=/absolute/path/outside/repo/dev.crt
TLS_CERT_PATH=

# ---------------------------------------------------------------------------
# HTTP Strict Transport Security (HSTS)
# ---------------------------------------------------------------------------

# `Strict-Transport-Security` max-age, in SECONDS. Default: 31536000 - one
# year, matching the security middleware's verified default, and always emitted
# together with `includeSubDomains` (which is hard-coded and has no variable).
# Exposed here so a deployment can stage its rollout with a short age first;
# 0 is legitimate and is how a previously issued pin is retracted.
#
# The header is emitted UNCONDITIONALLY, including over plain HTTP where
# browsers ignore it. That is intentional, not a defect: it is inert and
# harmless in the cleartext default and becomes effective the instant
# TLS_ENABLED is turned on, which removes the class of bug where the header is
# forgotten at exactly that moment.
HSTS_MAX_AGE=31536000
